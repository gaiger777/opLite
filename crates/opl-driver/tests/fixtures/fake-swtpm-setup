#!/usr/bin/env python3
"""가짜 swtpm_setup(계획 59 시험용). `--tpm-state DIR`에 무작위 `tpm2-00.permall`(0600)을 만든다.
`--not-overwrite`면 있는 파일은 그대로 둔다. 상태 디렉터리 안에 `fail-setup`이 있으면 실패한다."""
import os
import sys

argv = sys.argv[1:]
state = argv[argv.index("--tpm-state") + 1]
if os.path.exists(os.path.join(state, "fail-setup")):
    print("swtpm_setup: Could not create the EK", file=sys.stderr)
    sys.exit(1)
path = os.path.join(state, "tpm2-00.permall")
if os.path.exists(path) and "--not-overwrite" in argv:
    sys.exit(0)
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
os.write(fd, os.urandom(64))
os.close(fd)
