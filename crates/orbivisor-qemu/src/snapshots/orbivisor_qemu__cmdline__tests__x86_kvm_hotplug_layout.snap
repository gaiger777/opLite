---
source: crates/orbivisor-qemu/src/cmdline.rs
expression: "args.join(\"\\n\")"
---
-name
guest=web-01,debug-threads=on
-uuid
00000000-0000-0000-0000-000000000000
-no-user-config
-nodefaults
-S
-machine
q35,accel=kvm
-cpu
host
-smp
2,sockets=1,cores=8,threads=1,maxcpus=8
-m
4096M,maxmem=16384M
-device
host-x86_64-cpu,id=cpu2,socket-id=0,core-id=2,thread-id=0
-device
host-x86_64-cpu,id=cpu3,socket-id=0,core-id=3,thread-id=0
-drive
if=pflash,unit=0,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE.fd
-drive
if=pflash,unit=1,format=raw,file=/run/opl/vm/00000000-0000-0000-0000-000000000000/uefi-vars.fd
-device
VGA,id=video0
-device
qemu-xhci,id=usb
-device
usb-tablet,bus=usb.0
-device
usb-kbd,bus=usb.0
-device
pcie-root-port,id=hp0,bus=pcie.0,chassis=1,addr=0x1e.0,io-reserve=0,multifunction=on
-device
pcie-root-port,id=hp1,bus=pcie.0,chassis=2,addr=0x1e.1,io-reserve=0
-device
pcie-root-port,id=hp2,bus=pcie.0,chassis=3,addr=0x1e.2,io-reserve=0
-device
pcie-root-port,id=hp3,bus=pcie.0,chassis=4,addr=0x1e.3,io-reserve=0
-device
pcie-root-port,id=hp4,bus=pcie.0,chassis=5,addr=0x1e.4,io-reserve=0
-device
pcie-root-port,id=hp5,bus=pcie.0,chassis=6,addr=0x1e.5,io-reserve=0
-device
pcie-root-port,id=hp6,bus=pcie.0,chassis=7,addr=0x1e.6,io-reserve=0
-device
pcie-root-port,id=hp7,bus=pcie.0,chassis=8,addr=0x1e.7,io-reserve=0
-blockdev
driver=file,filename=/var/lib/opl/pools/local/web-01-root.qcow2,node-name=disk0-file
-blockdev
driver=qcow2,file=disk0-file,node-name=disk0
-device
virtio-blk-pci,drive=disk0,id=disk0-dev,bootindex=1
-blockdev
driver=file,filename=/var/lib/opl/pools/local/web-01-data.raw,node-name=disk1-file
-blockdev
driver=raw,file=disk1-file,node-name=disk1
-device
ide-hd,drive=disk1,bus=ide.0,id=disk1-dev
-blockdev
driver=file,filename=/var/lib/opl/pools/local/web-01-hot.qcow2,node-name=disk2-file
-blockdev
driver=qcow2,file=disk2-file,node-name=disk2
-device
virtio-blk-pci,drive=disk2,id=disk2-dev,bus=hp0
-netdev
tap,id=net0,ifname=tap0i0,script=no,downscript=no
-device
virtio-net-pci,netdev=net0,mac=52:54:00:12:34:56,id=nic0
-netdev
user,id=net1
-device
e1000e,netdev=net1,mac=52:54:00:12:34:57,id=nic1
-netdev
user,id=net2
-device
virtio-net-pci,netdev=net2,mac=52:54:00:12:34:58,id=nic2,bus=hp1
-object
memory-backend-ram,id=vmem0,size=12288M
-device
virtio-mem-pci,id=vmem0-dev,memdev=vmem0,block-size=2M,requested-size=2048M
-vnc
unix:/run/opl/vm/00000000-0000-0000-0000-000000000000/vnc.sock
-qmp
unix:/run/opl/vm/00000000-0000-0000-0000-000000000000/qmp.sock,server=on,wait=off
-pidfile
/run/opl/vm/00000000-0000-0000-0000-000000000000/qemu.pid
