# Orbivisor vTPM: swtpm state and runtime files, included from /etc/apparmor.d/local/usr.bin.swtpm
# (the Ubuntu/Debian swtpm profile). The paths are orbivisord's defaults: data_dir=/var/lib/orbivisor,
# run_dir=/run/orbivisor. The old names (/var/lib/opl, /run/opl) are links to them since the rename and stay
# allowed: a swtpm started before the rename opened its files by the old names.
# With another data_dir or run_dir, add the same rules for those paths to /etc/apparmor.d/local/usr.bin.swtpm
# and reload the profile: apparmor_parser -r /etc/apparmor.d/usr.bin.swtpm

  /var/lib/orbivisor/vm/*/tpm/ rw,
  /var/lib/orbivisor/vm/*/tpm/** rwk,
  /run/orbivisor/vm/*/ r,
  /run/orbivisor/vm/*/tpm.sock rw,
  /run/orbivisor/vm/*/swtpm.pid rw,
  /run/orbivisor/vm/*/swtpm.log rw,
  /var/lib/opl/vm/*/tpm/ rw,
  /var/lib/opl/vm/*/tpm/** rwk,
  /run/opl/vm/*/ r,
  /run/opl/vm/*/tpm.sock rw,
  /run/opl/vm/*/swtpm.pid rw,
  /run/opl/vm/*/swtpm.log rw,
