# /etc/opl/opld.toml로 복사해 name·address를 고친다
name = "node1"
address = "10.0.0.11"
# [hypervisor]
# accel = "auto"          # auto | kvm | tcg
# systemd_scope = true
# [janitor]
# task_max_age_days = 7     # 끝난 작업(Task)을 남기는 날수(만든 때부터)
# task_max_finished = 1000  # 끝난 작업을 이보다 많이 남기지 않는다(오래된 것부터 지운다)
# [backup]
# tick_secs = 60          # 백업 작업을 확인하는 간격(초, 리더 노드)
# max_concurrent = 2      # 노드마다 동시에 도는 백업 작업(Task)의 최대 수
# [replication]
# tick_secs = 60          # 주기가 지난 로컬 디스크 복제 대상을 확인하는 간격(초, 리더 노드)
# max_concurrent = 2      # 원본 노드마다 동시에 도는 복제 작업(Task)의 최대 수(VM 줄에서 기다리는 Task는 세지 않는다)
# bandwidth_mib = 0       # 복제가 보내는 대역폭 상한(MiB/s, 디스크 수로 나눈다). 0이면 제한 없음
# [ceph]
# client_dir = "/etc/opl/ceph"   # 관리 Ceph의 클라이언트 설정·키링(등록하는 RBD 풀의 conf는 {client_dir}/ceph.conf — 모든 노드에서 같아야 한다)
# packages = ["ceph-mon", "ceph-mgr", "ceph-osd", "ceph-volume", "ceph-common", "lvm2", "qemu-block-extra"]  # mon·mgr·OSD 노드에 까는 꾸러미
# client_packages = ["ceph-common", "qemu-block-extra"]  # RBD 풀만 쓰는 노드에 까는 꾸러미
# install_timeout_secs = 1800    # apt-get update·install 하나의 시간 한도(초)
# allow_loop_devices = false     # 루프 장치도 OSD 디스크로 쓴다(시험용)
# status_cache_secs = 5          # Ceph 상태를 다시 읽지 않고 돌려주는 시간(초, 0이면 늘 다시 읽음)
# [download]
# allow_private = false     # URL에서 받기(volume·iso download)가 루프백·링크 로컬·사설망 주소에서도 받는다(사내 미러)
# [pools]
# refresh_secs = 15         # 노드별 풀 상태를 확인하는 간격(초, NFS 마운트 포함)
# [runtime]
# api_threads = 4           # API 실행기의 작업자 수(기본: CPU 수의 절반, 최소 2)
# work_threads = 4          # VM·작업 실행기의 작업자 수(기본: CPU 수의 절반, 최소 2)
