[Unit]
Description=Orbivisor node daemon
Documentation=https://github.com/gaiger777/opLite
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/opl/opld.toml

[Service]
# 시작이 끝나면 READY=1을, core·api 실행기가 답하는 동안 10초마다 WATCHDOG=1을 보낸다. 30초 넘게
# 없으면 systemd가 SIGKILL로 끝내고 다시 띄운다(코어 덤프로 늦지 않게, 진단은 늦은 회차의 경고 로그.
# KillMode=process라 VM은 그대로 돈다).
Type=notify
NotifyAccess=main
WatchdogSec=30s
WatchdogSignal=SIGKILL
ExecStart=/usr/bin/orbivisord --config /etc/opl/opld.toml
# 프로세스가 죽어(SIGKILL 등) 떼지 못한 내장 VIP를 뗀다(늘 0으로 끝난다).
ExecStopPost=/usr/bin/orbivisord --config /etc/opl/opld.toml --release-vips
Restart=on-failure
RestartSec=5
KillMode=process
# 호스트가 꺼질 때 종료 정책(migrate는 비우기를 10분까지 기다린 뒤 HA VM을 끈다)이 끝날 시간. VM 스코프는
# Before=opld.service라 opld가 끝난 뒤에 멈춘다.
TimeoutStopSec=15min
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
