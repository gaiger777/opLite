#!/bin/sh
# orbivisor prerm. 지울 때만 orbivisord를 멈춘다(업그레이드는 postinst가 다시 시작한다).
# VM의 QEMU는 자기 scope에 있어 계속 돌고, 다시 설치한 orbivisord가 이어 맡는다.
set -eu

SYSTEMD_DIR="${ORBIVISOR_SYSTEMD_DIR:-/run/systemd/system}"

case "$1" in
remove | deconfigure)
	if [ -d "$SYSTEMD_DIR" ]; then
		systemctl stop orbivisord.service || true
	fi
	;;
esac

exit 0
